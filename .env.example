# 将密钥填写到本地 .env，不要写到此示例文件。
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=Qwen/Qwen3-VL-Embedding-8B
EMBEDDING_DIMENSIONS=1024

# 服务治理参数在启动前 export；密钥仍只写在本地 .env。
# RECIPE_WORKERS=2
# RECIPE_GLOBAL_WORKERS=2
# RECIPE_QUEUE_CAPACITY=8
# RECIPE_REQUEST_SECONDS=180
# RECIPE_USER_RPM=60
# RECIPE_MODEL_CONCURRENCY=2
# 重排可选阶段的本地排队上限（进程环境变量）；API总预算仍为8秒。
# RAG_RERANK_ADMISSION_SECONDS=0.5
# 按开发集10/20/30候选对照选择默认10；可设置1至50重新验收。
# RAG_RERANK_CANDIDATES=10
# 两项语义复核默认关闭思考模式；设置进程变量为1可做质量/耗时对照。
# RECIPE_REVIEW_THINKING=0
# RECIPE_MODEL_RPM=60
# RECIPE_MODEL_TPM=60000
# 本地模式仅允许目录、原文和图片；运行入口默认开启。
# RECIPE_LOCAL_ONLY=1
# RECIPE_QA_PROFILE=balanced
# 本地启动入口使用独立data/runtime/local-jobs.sqlite3，不混用完整模式队列。
# 可选本地访问口令（与模型密钥不同，16至128位字母数字/_/-）
# RECIPE_ACCESS_TOKEN=


# 聊天生成、复核、单/多 Agent、记忆共用；本地 LLM_API_KEY 填硅基流动密钥，独立于 Embedding 配置。
LLM_API_KEY=
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=workbuddy-ai/deepseek-v4.1-flash

# 仅评测使用的独立评审模型；同供应商可复用聊天密钥。
EVAL_JUDGE_MODEL=Qwen/Qwen3.5-35B-A3B
# EVAL_JUDGE_BASE_URL=https://api.siliconflow.cn/v1
# EVAL_JUDGE_API_KEY=

COOKBUDDY_ENABLED=1
COOKBUDDY_DB_PASSWORD=
COOKBUDDY_DATABASE_URL=
COOKBUDDY_MILVUS_URL=http://127.0.0.1:19532
COOKBUDDY_ADMIN_DATABASE_URL=
COOKBUDDY_SESSION_SECRET=
