{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Recipe facts v0.2",
  "type": "object",
  "required": [
    "schema_version",
    "recipe_id",
    "title",
    "source",
    "source_sha256",
    "curation",
    "review_status",
    "entities",
    "alternative_groups",
    "issues",
    "extraction",
    "validation",
    "activation",
    "answer_policy",
    "version_preparation"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2"
    },
    "recipe_id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "curation": {
      "type": "string",
      "minLength": 1
    },
    "review_status": {
      "type": "string",
      "minLength": 1
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "alternative_groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/group"
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    },
    "extraction": {
      "type": "object",
      "required": [
        "method",
        "model",
        "prompt_version",
        "source_sha256",
        "media_mode"
      ],
      "properties": {
        "method": {
          "enum": [
            "manual_curation",
            "model_extraction"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "prompt_version": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "media_mode": {
          "const": "text_only"
        }
      }
    },
    "validation": {
      "type": "object",
      "required": [
        "structural_status",
        "semantic_status",
        "warnings"
      ],
      "properties": {
        "structural_status": {
          "enum": [
            "not_checked",
            "passed"
          ]
        },
        "semantic_status": {
          "type": "string",
          "minLength": 1
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "activation": {
      "type": "object",
      "required": [
        "enabled",
        "reason"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "answer_policy": {
      "type": [
        "object",
        "null"
      ]
    },
    "version_preparation": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "version",
          "basis",
          "entries"
        ],
        "properties": {
          "version": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "basis": {
            "type": "string",
            "minLength": 1
          },
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "entity_id",
                "name",
                "alternative_group",
                "evidence_lines"
              ],
              "properties": {
                "entity_id": {
                  "type": "string",
                  "minLength": 1
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "alternative_group": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1
                },
                "evidence_lines": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_id",
        "requirement",
        "quantity_raw",
        "stage",
        "version",
        "condition_raw",
        "purpose",
        "source",
        "section",
        "start_line",
        "end_line",
        "quote"
      ],
      "properties": {
        "observation_id": {
          "type": "string",
          "minLength": 1
        },
        "requirement": {
          "enum": [
            "listed_required",
            "optional",
            "conditional",
            "advanced_list",
            "step_usage",
            "mentioned"
          ]
        },
        "quantity_raw": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "stage": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "version": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "condition_raw": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "purpose": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "section": {
          "type": "string"
        },
        "start_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "requirement": {
                "const": "conditional"
              }
            }
          },
          "then": {
            "properties": {
              "condition_raw": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_id",
        "canonical_name",
        "aliases",
        "category",
        "alternative_group",
        "observations",
        "review_note",
        "alternative_group_ids"
      ],
      "properties": {
        "entity_id": {
          "type": "string",
          "minLength": 1
        },
        "canonical_name": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "category": {
          "enum": [
            "ingredient",
            "seasoning",
            "tool",
            "intermediate",
            "finished_product"
          ]
        },
        "alternative_group": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "observations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/observation"
          }
        },
        "review_note": {
          "type": "string"
        },
        "alternative_group_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "group_id",
        "members",
        "satisfaction_rule",
        "note"
      ],
      "properties": {
        "group_id": {
          "type": "string",
          "minLength": 1
        },
        "members": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "satisfaction_rule": {
          "enum": [
            "any_one",
            "one_or_more",
            "conditional_any_one"
          ]
        },
        "note": {
          "type": "string"
        }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "note",
        "lines"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
